# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
JWT_SECRET=change_me_to_a_long_random_string

# MySQL connection (run sql/reset_demo.sql in MySQL Workbench first)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=meow_meow_tarot

# Demo accounts, one per role (created or refreshed on every start)
ADMIN_EMAIL=admin@meowtarot.com
ADMIN_PASSWORD=change_me_admin
DEV_EMAIL=dev@meowtarot.com
DEV_PASSWORD=change_me_dev
USER_EMAIL=testja@meowtarot.com
USER_PASSWORD=change_me_user
