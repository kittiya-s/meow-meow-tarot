# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
JWT_SECRET=

# MySQL connection (run sql/reset_demo.sql, then create the meow_app user)
DB_HOST=localhost
DB_PORT=3306
DB_USER=meow_app
DB_PASSWORD=
DB_NAME=meow_meow_tarot

# Demo accounts: an account is only created when its password is set
ADMIN_EMAIL=admin@meowtarot.com
ADMIN_PASSWORD=
DEV_EMAIL=dev@meowtarot.com
DEV_PASSWORD=
USER_EMAIL=testja@meowtarot.com
USER_PASSWORD=